{
  "component": "decomposer",
  "model_name": "phi_4_mini_instruct",
  "model_id": "microsoft/Phi-4-mini-instruct",
  "prompt_file": "prompt.md",
  "unguided_prompt_file": null,
  "prompt_style": "plain",
  "generation": {
    "max_new_tokens": 128,
    "do_sample": false,
    "temperature": 0.0,
    "top_p": 1.0
  },
  "loader": {
    "trust_remote_code": false,
    "quantization": "none",
    "cuda_dtype": "float16",
    "cpu_dtype": "float32",
    "device_map_cuda": "auto"
  },
  "few_shot": {
    "enabled": false,
    "k": 3
  },
  "post_process": {
    "strip_think": false,
    "truncate_at": ["Question:"]
  },
  "logging": {
    "prompt_log_every": 5
  },
  "notes": "v1's decomposer.py for this folder was byte-identical to the qwen2_5_3b one; same inline-examples prompt, no retrieval or pool support."
}
