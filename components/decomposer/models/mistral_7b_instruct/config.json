{
  "component": "decomposer",
  "model_name": "mistral_7b_instruct",
  "model_id": "mistralai/Mistral-7B-Instruct-v0.3",
  "prompt_file": "prompt.md",
  "unguided_prompt_file": "prompt_unguided.md",
  "prompt_style": "plain",
  "generation": {
    "max_new_tokens": 128,
    "do_sample": false,
    "temperature": 0.0,
    "top_p": 1.0
  },
  "loader": {
    "trust_remote_code": false,
    "quantization": "none",
    "cuda_dtype": "float16",
    "cpu_dtype": "float32",
    "device_map_cuda": "auto"
  },
  "few_shot": {
    "enabled": true,
    "k": 3
  },
  "post_process": {
    "strip_think": false,
    "truncate_at": ["Question:"]
  },
  "logging": {
    "prompt_log_every": 5
  },
  "notes": "Mirrors v1 components/decomposer/models/mistral_7b_instruct/decomposer.py: similarity or reranked few-shot examples, {few_shot_examples} in both prompt halves, quantization selectable at the CLI."
}
