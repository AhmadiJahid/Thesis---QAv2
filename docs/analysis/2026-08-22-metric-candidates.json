 "candidate_definitions": {
  "sari": {
   "source": "allenai/break-evaluator evaluation/sari_hook.py (Tensor2Tensor port of Xu et al., TACL 2016); driver scripts/evaluate_predictions.py get_sari_score",
   "verified": "reimplemented line-by-line from the fetched official file; max_gram_size=4, BETA_FOR_SARI_DELETION_F_MEASURE=0",
   "inputs": "source = the original question split on ' '; prediction/target = the ' @@SEP@@ '-joined decomposition string split on ' '",
   "model_free": true,
   "per_item": true
  },
  "structural_match": {
   "source": "allenai/break-evaluator evaluation/sequence_matcher.py clean_structural + get_match_score, driven by get_structural_match_ratio",
   "verified": "reimplemented from the fetched official file; the ratio is edit_distance.SequenceMatcher.ratio() = 2*matches/(len(a)+len(b)), reimplemented from belambert/edit-distance edit_distance/edit_distance.py",
   "note": "clean_structural keeps every token starting with '@@', which on Break's own to_string() output INCLUDES the '@@SEP@@' separators, so the official metric is part chaining-structure and part step-count",
   "model_free": true,
   "per_item": true
  },
  "ged": {
   "source": "allenai/break-evaluator evaluation/graph_matcher.py GraphMatchScorer.normalized_graph_edit_distance + evaluation/decomposition.py to_graph",
   "verified": "graph construction and normalization reimplemented from the fetched official files; nx.optimize_graph_edit_distance, last yielded value, normalized by max(nodes+edges)",
   "deviation_from_official": "Break's node substitution cost is 1 - SequenceMatchScorer.get_match_score, whose 'base' processing lemmatizes with spaCy en_core_web_sm. spaCy is not installed in this repo's .venv, so this note used lowercased whitespace tokens with no lemmatization. Absolute values are therefore NOT comparable to Break leaderboard GED numbers; within this note all systems are scored the same way.",
   "budget": "per-item wall-clock budget 20.0 s (Break itself uses @exit_after(180) and DROPS examples that time out); truncations observed: {\"exp004_unguided\": 0, \"exp004_oracle_guided\": 0, \"exp004_unguided_capped\": 0, \"exp005_unguided\": 0, \"exp005_oracle_guided\": 0, \"exp005_unguided_capped\": 0, \"exp008_full_train\": 0, \"exp009_mixed\": 0, \"exp009_oracle_hop_matched\": 0, \"null_empty\": 0, \"null_question_echo\": 0, \"null_one_junk\": 0, \"null_three_junk\": 0, \"null_gold_reversed\": 0, \"oracle_gold\": 0}",
   "direction": "lower is better (it is a distance); can exceed 1.0",
   "model_free": true,
   "per_item": true
  },
  "break_em": {
   "source": "allenai/break-evaluator scripts/evaluate_predictions.py get_exact_match: d.lower() == g.lower() on the ' @@SEP@@ '-joined string",
   "note": "differs from this repo's exact_match_rate, which strips punctuation except '#' via _normalize_step",
   "model_free": true,
   "per_item": true
  },
  "chain_validity": {
   "source": "NOT from the literature: it is PR #38 section 5 option 3(a) made concrete \u2014 per-item bare-#k reference validity with no free credit for silence",
   "definition": "per item: 1.0 if the gold needs no reference; 0.0 if the gold needs one and the prediction emits none; else valid_pred_refs / pred_refs, valid meaning 1 <= k < own 1-based step index",
   "model_free": true,
   "per_item": true
  }
 },
