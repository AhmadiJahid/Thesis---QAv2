 "category_definitions": {
  "over_count": "len(pred_steps) > len(gold_steps)",
  "under_count": "len(pred_steps) < len(gold_steps)",
  "exact_count": "len(pred_steps) == len(gold_steps)",
  "runaway": "len(pred_steps) >= 10 or >= 2*len(gold)+4",
  "template_leak": "a predicted step is a bare prompt-scaffold line (Task:/Answer:/Question:/Decomposition:/Note/Example/Explanation)",
  "template_loop": ">=3 predicted steps identical after replacing digit runs with N",
  "duplicate_step": "two predicted steps identical after lowercasing/punctuation stripping",
  "orphan_step": "the plan emits >=1 back-reference, and some non-final step is never referenced by any later step (a sub-question computed and then discarded)",
  "ref_out_of_range": "evaluator chain_validity < 1.0 with >=1 predicted reference (a #k that is forward or self)",
  "no_refs_though_gold_chains": "prediction emits no #k at all while gold does (evaluator chain_validity = 0.0 by the METRICS.md 2.1 repair)",
  "bracketed_ref_syntax": "a predicted step writes [#k] rather than #k",
  "question_restatement": "a predicted step reuses >=85% of its own tokens from the question and covers >=70% of the question's tokens",
  "exemplar_entity_bleed": "a capitalised entity in the prediction occurs in the few-shot block of that item's own prompt and not in the question",
  "novel_entity": "a capitalised entity in the prediction occurs neither in the question nor in the few-shot block",
  "gold_verbatim": "evaluator exact_match == 1.0",
  "right_shape_wrong_words": "same step count as gold, evaluator step_f1 == 0.0, rouge_l_f1 >= 0.5"
 },
